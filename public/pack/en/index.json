, "intro": "A duck!", "say": "Quack quack! The duck says quack.", "find": "Where is the duck?", "found": "You found the duck!", "that": "That's a duck!", "bye": "Duck, bye-bye!"}, "media": 3, "tip": "洗澡放小黄鸭：Where is the duck? 孩子拿起来，你说：Quack quack! Yes, a duck!"}, {"id": "chicken", "theme": "farm", "zh": "母鸡", "emoji": "🐔", "en": {"word": "chicken", "intro": "A chicken!", "say": "Cluck cluck! The chicken says cluck.", "find": "Where is the chicken?", "found": "You found the chicken!", "that": "That's a chicken!", "bye": "Chicken, bye-bye!"}, "media": 3, "tip": "早餐吃鸡蛋时说：The chicken says cluck cluck. 可以张开手臂学小鸡扇翅膀。"}, {"id": "sheep", "theme": "farm", "zh": "绵羊", "emoji": "🐑", "en": {"word": "sheep", "intro": "A sheep!", "say": "Baa! The sheep says baa.", "find": "Where is the sheep?", "found": "You found the sheep!", "that": "That's a sheep!", "bye": "Sheep, bye-bye!"}, "media": 3, "tip": "摸毛绒玩具或毛衣时说：So soft, like a sheep. Baa!"}, {"id": "horse", "theme": "farm", "zh": "马", "emoji": "🐴", "en": {"word": "horse", "intro": "A horse!", "say": "Neigh! The horse says neigh.", "find": "Where is the horse?", "found": "You found the horse!", "that": "That's a horse!", "bye": "Horse, bye-bye!"}, "media": 3, "tip": "让孩子骑在你腿上颠一颠：Ride the horse! Neigh! 孩子通常会要求“再来一次”，正好多说几遍。"}, {"id": "rabbit", "theme": "farm", "zh": "兔子", "emoji": "🐰", "en": {"word": "rabbit", "intro": "A rabbit!", "say": "Hop hop! The rabbit can hop.", "find": "Where is the rabbit?", "found": "You found the rabbit!", "that": "That's a rabbit!", "bye": "Rabbit, bye-bye!"}, "media": 3, "tip": "和孩子一起跳一跳：Hop hop, like a rabbit! 说一次 hop 就跳一下。"}, {"id": "mouse", "theme": "farm", "zh": "老鼠", "emoji": "🐭", "en": {"word": "mouse", "intro": "A mouse!", "say": "Squeak squeak! The mouse says squeak.", "find": "Where is the mouse?", "found": "You found the mouse!", "that": "That's a mouse!", "bye": "Mouse, bye-bye!"}, "media": 3, "tip": "玩捉迷藏时小声说：Shh, quiet like a mouse. Squeak!"}, {"id": "apple", "theme": "food", "zh": "苹果", "