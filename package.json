{
  "name": "sprout-english",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5190",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5190",
    "pack": ".venv/bin/python scripts/build.py",
    "art": ".venv/bin/python scripts/import_art.py && .venv/bin/python scripts/build.py",
    "audio": ".venv/bin/python scripts/gen_audio.py && .venv/bin/python scripts/build.py",
    "prompts": ".venv/bin/python scripts/gen_prompts.py",
    "images": ".venv/bin/python scripts/gen_images.py"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "6.4.1"
  }
}
